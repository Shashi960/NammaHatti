# Database
MONGODB_URI=mongodb://localhost:27017/localmesh

# Authentication
JWT_SECRET=localmesh-dev-secret-super-secure-key-at-least-32-chars-long!
SESSION_EXPIRY_DAYS=7

# Platform Configuration
BRAND_NAME=LocalMesh
BRAND_TAGLINE=Shop Local. Deliver Smarter.
NEXT_PUBLIC_BRAND_NAME=LocalMesh

# Google Maps Platform (optional, application falls back smoothly to Haversine/OpenStreetMap)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Node Environment
NODE_ENV=development
